# KiCad editor state and recovery files
*-backups/
*.kicad_prl
*.kicad_sch-bak
*.kicad_pcb-bak
_autosave-*
fp-info-cache
~*.lck
*.lck

# Local editor, operating-system, and temporary files
.DS_Store
Thumbs.db
~$*
*.bak
*.tmp
*-bak
_tmp_*
_gitwork/
.history/
hardware/.history/
