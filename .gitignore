# Python/runtime state
__pycache__/
*.py[cod]
.venv/

# Generated local build and CI output
firmware/build/
firmware/.pio/
out/
tmp*.rpt

# Local secrets; no credentials belong in the project
.env
.env.*
!.env.example
secrets.h
credentials.json

# Frozen fabrication packages, signed-off reports, and measurement records
# should be committed deliberately rather than excluded by blanket patterns.
